-- ==========================================
-- SHELF BOT — full build
-- move speed 40, single prompt fire with retry, continuous player exile, dwell 5s
-- ==========================================

local RunService          = game:GetService("RunService")
local Players             = game:GetService("Players")
local PathfindingService  = game:GetService("PathfindingService")
local TweenService        = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage   = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Character, Humanoid, HRP

-- ── Config ────────────────────────────────
local FIXED_POSITION        = Vector3.new(-515, 199, 141)
local PROMPT_HOLD_TIME      = 0.05
local PROMPT_WAIT_TIMEOUT   = 1.5    -- seconds to wait for remote after each fire
local MAX_PROMPT_ATTEMPTS   = 50     -- max individual fires before giving up
local MOVE_SPEED            = 40
local WAYPOINT_SPACING      = 3
local HITBOX_DWELL          = 5
local EXILE_CF              = CFrame.new(0, 0, 0)
local EXILE_DRIFT_THRESHOLD = 10
local DEBUG                 = true

-- ── State ─────────────────────────────────
local assignedShelf = nil
local shelfSignal   = Instance.new("BindableEvent")

-- ── Logging ───────────────────────────────
local function Log(msg)
    if DEBUG then print("[ShelfBot]", msg) end
end

-- ── Remote wiring ─────────────────────────
local ShelfAssignedEvent = ReplicatedStorage:WaitForChild("ShelfAssigned")
ShelfAssignedEvent.OnClientEvent:Connect(function(shelf)
    assignedShelf = shelf
    shelfSignal:Fire(shelf)
    Log("ShelfAssigned received: " .. tostring(shelf and shelf:GetFullName()))
end)

-- ── Player exile ──────────────────────────
local function ExilePlayer(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = EXILE_CF end
end

local function ExileAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        ExilePlayer(player)
    end
end

ExileAllPlayers()

Players.PlayerAdded:Connect(function(player)
    ExilePlayer(player)
    player.CharacterAdded:Connect(function()
        task.wait(0.1)
        ExilePlayer(player)
    end)
end)

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function()
            task.wait(0.1)
            ExilePlayer(player)
        end)
    end
end

RunService.Heartbeat:Connect(function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Position.Magnitude > EXILE_DRIFT_THRESHOLD then
            hrp.CFrame = EXILE_CF
        end
    end
end)

-- ── Path visuals ──────────────────────────
local PathVisualsFolder  = Instance.new("Folder")
PathVisualsFolder.Name   = "ShelfBotPathVisuals"
PathVisualsFolder.Parent = workspace

local function ClearPathVisuals()
    for _, c in ipairs(PathVisualsFolder:GetChildren()) do
        pcall(c.Destroy, c)
    end
end

local function VisualizePath(waypoints, startPos)
    ClearPathVisuals()
    if not waypoints or #waypoints == 0 then return end
    local prevPos = startPos
    for i, wp in ipairs(waypoints) do
        local part        = Instance.new("Part")
        part.Size         = Vector3.new(0.6, 0.6, 0.6)
        part.Position     = wp.Position
        part.Anchored     = true
        part.CanCollide   = false
        part.Material     = Enum.Material.Neon
        part.Color        = Color3.fromHSV(i / #waypoints, 1, 1)
        part.Transparency = 0.3
        part.Parent       = PathVisualsFolder

        local dist = (wp.Position - prevPos).Magnitude
        if dist > 0.5 then
            local line        = Instance.new("Part")
            line.Anchored     = true
            line.CanCollide   = false
            line.Material     = Enum.Material.Neon
            line.Color        = Color3.new(0, 1, 0)
            line.Transparency = 0.5
            line.Size         = Vector3.new(0.3, 0.3, dist)
            line.CFrame       = CFrame.lookAt(prevPos + (wp.Position - prevPos) / 2, wp.Position)
            line.Parent       = PathVisualsFolder
        end
        prevPos = wp.Position
    end
end

-- ── Pathfinding ───────────────────────────
local PATH_PARAMS = {
    { Radius = 1,   Height = 4,   Spacing = 2   },
    { Radius = 1.2, Height = 4.5, Spacing = 2.5 },
    { Radius = 1.5, Height = 5,   Spacing = 3   },
    { Radius = 2,   Height = 5.5, Spacing = 4   },
    { Radius = 2.5, Height = 6,   Spacing = 5   },
    { Radius = 3,   Height = 6.5, Spacing = 5   },
    { Radius = 3.5, Height = 7,   Spacing = 6   },
    { Radius = 4,   Height = 7.5, Spacing = 6   },
    { Radius = 1,   Height = 8,   Spacing = 3   },
    { Radius = 5,   Height = 5,   Spacing = 5   },
}

local function ComputePath(startPos, endPos)
    for _, p in ipairs(PATH_PARAMS) do
        local path = PathfindingService:CreatePath({
            AgentRadius     = p.Radius,
            AgentHeight     = p.Height,
            AgentCanJump    = true,
            AgentCanClimb   = true,
            WaypointSpacing = p.Spacing,
        })
        local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
        if ok and path.Status == Enum.PathStatus.Success then
            local raw = path:GetWaypoints()
            if not raw or #raw < 2 then return raw end
            local refined = { raw[1] }
            for i = 2, #raw do
                local prev = raw[i - 1].Position
                local curr = raw[i].Position
                local dist = (curr - prev).Magnitude
                if dist <= WAYPOINT_SPACING then
                    table.insert(refined, raw[i])
                else
                    local steps = math.ceil(dist / WAYPOINT_SPACING)
                    for j = 1, steps do
                        local alpha = j / steps
                        table.insert(refined, {
                            Position = prev:Lerp(curr, alpha),
                            Action   = j == steps and raw[i].Action or Enum.PathWaypointAction.Walk,
                        })
                    end
                end
            end
            return refined
        end
        task.wait(0.05)
    end
    return nil
end

-- ── Movement ──────────────────────────────
local function GetFootPosition()
    return HRP and (HRP.Position - Vector3.new(0, 2.5, 0)) or nil
end

local function MoveToPosition(endPos)
    if not HRP or not Humanoid then return false end
    local startPos = HRP.Position
    local path     = ComputePath(startPos, endPos)
    if not path then
        Log("Path not found to " .. tostring(endPos))
        return false
    end
    Log("Path found — " .. #path .. " waypoints")
    VisualizePath(path, startPos)

    for _, waypoint in ipairs(path) do
        if not GetFootPosition() then continue end
        local targetHRP = waypoint.Position + Vector3.new(0, 2.5, 0)
        local dist      = (targetHRP - HRP.Position).Magnitude
        if dist > 0.2 then
            local rot      = HRP.CFrame - HRP.CFrame.Position
            local targetCF = CFrame.new(targetHRP) * rot
            local tween    = TweenService:Create(
                HRP,
                TweenInfo.new(dist / MOVE_SPEED, Enum.EasingStyle.Linear),
                { CFrame = targetCF }
            )
            tween:Play()
            tween.Completed:Wait()
        end
        if waypoint.Action == Enum.PathWaypointAction.Jump then
            Humanoid.Jump = true
            task.wait(0.1)
        end
    end

    ClearPathVisuals()
    local rot = HRP.CFrame - HRP.CFrame.Position
    HRP.CFrame = CFrame.new(endPos + Vector3.new(0, 2.5, 0)) * rot
    HRP.AssemblyLinearVelocity  = Vector3.zero
    HRP.AssemblyAngularVelocity = Vector3.zero
    Log("Reached " .. tostring(endPos))
    return true
end

local function MoveToPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local cf   = part.CFrame
    local look = cf.LookVector
    look = Vector3.new(look.X, 0, look.Z)
    if look.Magnitude < 0.1 then
        look = HRP.Position - cf.Position
        look = Vector3.new(look.X, 0, look.Z)
        if look.Magnitude < 0.1 then look = Vector3.new(1, 0, 0) end
    end
    return MoveToPosition(cf.Position + look.Unit * 4)
end

-- ── Proximity prompt — fire once, wait, retry on miss ────
local function FirePromptOnce()
    VirtualInputManager:SendKeyEvent(true,  Enum.KeyCode.E, false, nil)
    task.wait(PROMPT_HOLD_TIME)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
end

local function FirePromptUntilAssigned()
    Log("Firing prompt — waiting up to " .. PROMPT_WAIT_TIMEOUT .. "s per attempt")
    local attempts = 0

    while attempts < MAX_PROMPT_ATTEMPTS do
        attempts += 1
        Log("Prompt fire #" .. attempts)

        local resolved   = false
        local connection
        connection = shelfSignal.Event:Connect(function()
            resolved = true
            connection:Disconnect()
            connection = nil
        end)

        FirePromptOnce()

        -- Wait up to PROMPT_WAIT_TIMEOUT for the remote to respond
        local elapsed = 0
        local step    = 0.05
        while not resolved and elapsed < PROMPT_WAIT_TIMEOUT do
            task.wait(step)
            elapsed += step
        end

        if connection then
            connection:Disconnect()
            connection = nil
        end

        if resolved then
            Log("Remote responded on attempt " .. attempts)
            return true
        end

        Log("No response — retrying")
    end

    Log("Prompt gave up after " .. attempts .. " attempts")
    return false
end

-- ── Shelf resolution ──────────────────────
local function ResolveHitbox(shelf)
    if not shelf then return nil end
    local hitbox = shelf:FindFirstChild("Hitbox")
    if hitbox and hitbox:IsA("BasePart") then return hitbox end
    Log("No valid Hitbox on " .. tostring(shelf:GetFullName()))
    return nil
end

-- ── Character ─────────────────────────────
local function UpdateCharacter()
    Character = LocalPlayer.Character
    if Character then
        Humanoid = Character:FindFirstChildOfClass("Humanoid")
        HRP      = Character:FindFirstChild("HumanoidRootPart")
    else
        Humanoid, HRP = nil, nil
    end
end

-- ── Closest enabled ProximityPrompt ───────
local function GetClosestPromptPart()
    if not HRP then return nil end
    local best, bestDist = nil, math.huge
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc:IsA("ProximityPrompt") and desc.Enabled then
            local parent = desc.Parent
            if parent and parent:IsA("BasePart") then
                local d = (parent.Position - HRP.Position).Magnitude
                if d < bestDist then
                    bestDist = d
                    best     = parent
                end
            end
        end
    end
    return best
end

-- ── Main loop ─────────────────────────────
local function MainLoop()
    while true do
        repeat
            UpdateCharacter()
            task.wait(0.5)
        until Character and Humanoid and HRP and Humanoid.Health > 0

        Log("=== New cycle ===")
        assignedShelf = nil

        Log("Moving to fixed position " .. tostring(FIXED_POSITION))
        if not MoveToPosition(FIXED_POSITION) then
            Log("Failed to reach fixed position, retrying in 3s")
            task.wait(3)
            continue
        end
        Log("Arrived at fixed position")

        local promptPart = GetClosestPromptPart()
        if not promptPart then
            Log("No ProximityPrompt found, retrying in 2s")
            task.wait(2)
            continue
        end
        Log("Prompt at " .. promptPart:GetFullName())
        MoveToPart(promptPart)
        task.wait(0.5)

        local gotShelf = FirePromptUntilAssigned()
        if not gotShelf or not assignedShelf then
            Log("No shelf assigned, retrying cycle in 3s")
            task.wait(3)
            continue
        end

        local shelf  = assignedShelf
        local hitbox = ResolveHitbox(shelf)
        if not hitbox then
            Log("No Hitbox resolved, skipping cycle")
            task.wait(2)
            continue
        end

        Log("Moving to Hitbox: " .. hitbox:GetFullName())
        if not MoveToPart(hitbox) then
            Log("Failed to reach Hitbox, retrying in 2s")
            task.wait(2)
            continue
        end

        Log("At Hitbox — dwelling " .. HITBOX_DWELL .. "s")
        task.wait(HITBOX_DWELL)
        Log("Cycle complete")
    end
end

-- ── Boot ──────────────────────────────────
Log("Shelf Bot started")
UpdateCharacter()
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    UpdateCharacter()
end)
MainLoop()
