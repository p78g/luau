-- Spam the E key but stop early if the ShelfAssigned remote fires
local function SpamProximityPromptUntilAssigned()
    Log("Spamming proximity prompt until ShelfAssigned fires...")
    local attempts = 0
    local maxAttempts = 100       -- safety timeout (100 pulses ~ 50 seconds)
    while assignedShelf == nil and attempts < maxAttempts do
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, nil)
        task.wait(PROMPT_HOLD_TIME)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, nil)
        task.wait(PROMPT_GAP)
        attempts = attempts + 1
        if assignedShelf ~= nil then
            Log("ShelfAssigned received, stopping spam")
            break
        end
    end
    if assignedShelf == nil then
        Log("Warning: ShelfAssigned never fired after " .. maxAttempts .. " attempts")
    end
end

-- Main loop (revised step 2 and 3)
local function MainLoop()
    while true do
        -- Ensure character is alive
        repeat
            Character = LocalPlayer.Character
            if Character then
                Humanoid = Character:FindFirstChildOfClass("Humanoid")
                HRP = Character:FindFirstChild("HumanoidRootPart")
            end
            task.wait(0.5)
        until Character and Humanoid and HRP and Humanoid.Health > 0

        Log("=== New cycle ===")

        -- Step 1: Move to fixed position
        Log("Moving to fixed position: " .. tostring(FIXED_POSITION))
        if not MoveToPosition(FIXED_POSITION) then
            Log("Failed to reach fixed position, retrying in 3s")
            task.wait(3)
            continue
        end
        Log("Arrived at fixed position")

        -- Step 2: Move to the nearest ProximityPrompt's part
        local promptPart = GetClosestPromptPart()
        if promptPart then
            Log("Closest prompt found at: " .. promptPart:GetFullName())
            MoveToPart(promptPart)
            task.wait(0.5)
        else
            Log("No enabled ProximityPrompt available, retrying cycle")
            task.wait(2)
            continue
        end

        -- Step 3: Spam the prompt and listen for the remote at the same time
        assignedShelf = nil  -- Reset
        SpamProximityPromptUntilAssigned()

        -- After spamming, if still no shelf assigned, retry the whole cycle
        if assignedShelf == nil then
            Log("No shelf assigned, retrying cycle in 3 seconds")
            task.wait(3)
            continue
        end

        -- Step 4: Move to the assigned shelf's Hitbox
        local shelf = assignedShelf
        local hitbox = shelf and shelf:FindFirstChild("Hitbox")
        if not hitbox or not hitbox:IsA("BasePart") then
            Log("Assigned shelf does not have a valid Hitbox, skipping cycle")
            task.wait(2)
            continue
        end

        Log("Moving to assigned shelf's Hitbox: " .. hitbox:GetFullName())
        if not MoveToPart(hitbox) then
            Log("Failed to reach Hitbox, retrying cycle")
            task.wait(2)
            continue
        end

        -- Step 5: Wait 4 seconds at the Hitbox
        Log("Reached Hitbox, waiting 4 seconds...")
        task.wait(4)

        Log("Cycle complete, restarting")
    end
end
