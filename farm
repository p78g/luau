-- ==================== USB ====================

print("[FARM] USB")

local function try_grab_usb()
	local hacking_computer =
		workspace.Map.ObjectsOfInterest:
		FindFirstChild(
			"HackingComputer"
		)

	if not hacking_computer then
		return true
	end

	local usb_drive =
		hacking_computer:FindFirstChild(
			"USBDrive"
		)

	if not usb_drive then
		return true
	end

	local usb_main =
		usb_drive:FindFirstChild(
			"Main"
		)

	if not usb_main then
		return false
	end

	local usb_prompt =
		usb_main:FindFirstChildOfClass(
			"ProximityPrompt"
		)

	if not usb_prompt then
		return false
	end

	tween_to(usb_prompt)

	print(string.format(
		"[USB] Firing Dex at %.2f",
		tick()
	))

	dex_fire(usb_prompt)

	task.wait(1)

	return usb_drive.Parent == nil
end

local usb_timeout =
	tick() + 30

local usb_done = false

while not usb_done
	and tick() < usb_timeout do

	usb_done =
		try_grab_usb()

	if not usb_done then
		print(
			"[USB] Still present, retrying..."
		)

		task.wait(0.5)
	end
end

print("[FARM] USB done")

