-- ==================== TWEEN ====================

local function get_target_position(target)
	if typeof(target) == "Vector3" then
		return target
	end

	if not target or not target:IsA("Instance") then
		return nil
	end

	if target:IsA("BasePart") then
		return target.Position
	end

	if target:IsA("Model") then
		if target.PrimaryPart then
			return target.PrimaryPart.Position
		end

		local part = target:FindFirstChildWhichIsA("BasePart", true)

		if part then
			return part.Position
		end
	end

	return nil
end

local function tween_to(target)
	local pos = get_target_position(target)

	if not pos then
		return false
	end

	if not hrp or not hrp.Parent then
		refresh_character()
	end

	hrp.CFrame = CFrame.new(
		hrp.Position - Vector3.new(0, 7, 0)
	)

	task.wait(0.1)

	local underground_dest = CFrame.new(
		pos.X,
		pos.Y - 7,
		pos.Z
	)

	local distance = (
		hrp.Position -
		underground_dest.Position
	).Magnitude

	local duration = math.max(
		0.1,
		distance / TWEEN_SPEED
	)

	local tw = TweenService:Create(
		hrp,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = underground_dest
		}
	)

	tw:Play()
	tw.Completed:Wait()

	task.wait(0.2)

	local tw2 = TweenService:Create(
		hrp,
		TweenInfo.new(
			0.2,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = underground_dest
		}
	)

	tw2:Play()
	tw2.Completed:Wait()

	task.wait(0.2)

	local tw3 = TweenService:Create(
		hrp,
		TweenInfo.new(
			0.3,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = CFrame.new(pos)
		}
	)

	tw3:Play()
	tw3.Completed:Wait()

	task.wait(0.5)

	return true
end

-- ==================== DEX FIRE ====================

local function dex_fire(prompt)
	if not prompt then
		return false
	end

	if not prompt:IsA("ProximityPrompt") then
		return false
	end

	if not prompt.Parent then
		return false
	end

	if typeof(fireproximityprompt) ~= "function" then
		warn("[DEX] fireproximityprompt unavailable")
		return false
	end

	pcall(function()
		prompt.Enabled = true
	end)

	return pcall(function()
		fireproximityprompt(prompt)
	end)
end

-- ==================== HOLD ====================

local function hold_prompt(prompt, duration)
	if not prompt then
		return false
	end

	if not prompt:IsA("ProximityPrompt") then
		return false
	end

	if not prompt.Parent then
		return false
	end

	pcall(function()
		prompt.Enabled = true
	end)

	task.wait(0.2)

	if not prompt.Parent then
		return false
	end

	local success = pcall(function()
		prompt:InputHoldBegin()
	end)

	if not success then
		return false
	end

	task.wait(duration)

	if prompt.Parent then
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end

	task.wait(0.2)

	return true
end

-- ==================== PROMPT FINDER ====================

local function find_prompt(parent, name)
	if not parent then
		return nil
	end

	if name then
		local prompt = parent:FindFirstChild(name, true)

		if prompt and prompt:IsA("ProximityPrompt") then
			return prompt
		end
	end

	return parent:FindFirstChildWhichIsA(
		"ProximityPrompt",
		true
	)
end

local function wait_for_prompt(parent, timeout, name)
	local deadline = tick() + timeout

	while tick() < deadline do
		if not parent or not parent.Parent then
			return nil
		end

		local prompt = find_prompt(parent, name)

		if prompt and prompt.Parent then
			return prompt
		end

		task.wait(0.1)
	end

	return nil
end

-- ==================== HELPERS ====================

local function get_children_named(parent, name)
	local results = {}

	if not parent then
		return results
	end

	for _, v in ipairs(parent:GetChildren()) do
		if v.Name == name then
			table.insert(results, v)
		end
	end

	return results
end

local function pick_random(t)
	if #t == 0 then
		return nil
	end

	return t[math.random(1, #t)]
end

-- ==================== PACKAGE GATE ====================

local BLOCKED_CF = CFrame.new(
	-118.506042,
	8.12099838,
	-18.7696609,
	-0.999999762,
	0.000258913846,
	-0.000604276371,
	0.000259018154,
	0.99999994,
	-0.000172565764,
	0.000604231667,
	-0.000172722255,
	-0.999999762
)

local function is_package_blocked(base)
	if not base or not base:IsA("BasePart") then
		return false
	end

	return (
		base.Position -
		BLOCKED_CF.Position
	).Magnitude < 1
end

local function get_closest_removable_frame(ref_pos)
	local folder = workspace:FindFirstChild(
		"CollectableHighlights"
	)

	if not folder then
		return nil
	end

	local best
	local best_dist = math.huge

	for _, v in ipairs(folder:GetChildren()) do
		if v.Name == "RemovableFrame" then
			local main = v:FindFirstChild("Main")

			if main and main:IsA("BasePart") then
				local dist = (
					main.Position -
					ref_pos
				).Magnitude

				if dist < best_dist then
					best = main
					best_dist = dist
				end
			end
		end
	end

	if best and best_dist < 30 then
		return best
	end

	return nil
end

local function get_closest_mini_safe(ref_pos)
	local map = workspace:FindFirstChild("Map")

	if not map then
		return nil
	end

	local best
	local best_dist = math.huge

	for _, child in ipairs(map:GetChildren()) do
		local ms = child:FindFirstChild("MiniSafe")

		if ms then
			local door = ms:FindFirstChild("Door")

			if door and door:IsA("BasePart") then
				local dist = (
					door.Position -
					ref_pos
				).Magnitude

				if dist < best_dist then
					best = ms
					best_dist = dist
				end
			end
		end
	end

	if best and best_dist < 30 then
		return best
	end

	return nil
end

local function handle_package_gate(pkg)
	local base = pkg and pkg:FindFirstChild("Base")

	if not base or not is_package_blocked(base) then
		return
	end

	local rf_main = get_closest_removable_frame(
		base.Position
	)

	if rf_main then
		tween_to(rf_main)

		task.wait(0.3)

		local rf_prompt = wait_for_prompt(
			rf_main,
			3
		)

		if rf_prompt then
			hold_prompt(
				rf_prompt,
				0.3
			)

			task.wait(0.5)
		end
	end

	local ms = get_closest_mini_safe(
		base.Position
	)

	if ms then
		local drill = ms:FindFirstChild(
			"InsertDrill",
			true
		)

		if drill then
			local drill_prompt = wait_for_prompt(
				drill,
				3,
				"ProximityPromptPickLock"
			)

			if drill_prompt then
				tween_to(drill)

				task.wait(0.3)

				hold_prompt(
					drill_prompt,
					7.6
				)

				task.wait(0.5)
			end
		end
	end
end

