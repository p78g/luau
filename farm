-- ==================== CRATES ====================

print("[FARM] RushCrates")

local function get_crates()
	local folder = workspace:FindFirstChild("CollectableHighlights")

	if not folder then
		return {}
	end

	return get_children_named(folder, "RushCrate")
end

local crates = get_crates()

while #crates > 0 do
	local crate = pick_random(crates)

	if not crate or not crate.Parent then
		crates = get_crates()
		continue
	end

	tween_to(crate)

	local spacer = crate:FindFirstChild("Spacer", true)
	local prompt = spacer and wait_for_prompt(spacer, 3, "ProximityPrompt")

	if prompt then
		hold_prompt(prompt, 2.6)
	else
		warn("[CRATE] No prompt")
	end

	task.wait(0.3)

	crates = get_crates()
end

print("[FARM] Crates done")

-- ==================== BLUEPRINTS ====================

print("[FARM] Blueprints")

local rs_package = ReplicatedStorage:FindFirstChild("RS_Package")
local remotes = rs_package and rs_package:FindFirstChild("Remotes")
local throw_event = remotes and remotes:FindFirstChild("ThrowBag")

local bag_area = workspace:FindFirstChild("BagSecuredArea")
local floor_part = bag_area and bag_area:FindFirstChild("FloorPart")

local function get_blueprints()
	local folder = workspace:FindFirstChild("CollectableHighlights")

	if not folder then
		return {}
	end

	return get_children_named(folder, "Blueprint")
end

local function collect_blueprint(bp)
	if not bp or not bp.Parent then
		return false
	end

	tween_to(bp)

	task.wait(0.5)

	local bp_prompt = wait_for_prompt(bp, 5, "ProximityPrompt")

	if not bp_prompt then
		warn("[BP] No ProximityPrompt in: " .. bp:GetFullName())
		return false
	end

	if not bp_prompt.Enabled then
		local enabled_timeout = tick() + 3

		while not bp_prompt.Enabled and tick() < enabled_timeout do
			task.wait(0.1)
		end
	end

	task.wait(0.3)

	if not bp.Parent or not bp_prompt.Parent then
		return false
	end

	print("[BP] Holding prompt")

	local collected = hold_prompt(bp_prompt, 2.1)

	task.wait(0.5)

	return collected
end

local function throw_bag()
	if not floor_part or not floor_part.Parent then
		return false
	end

	tween_to(floor_part)

	task.wait(0.5)

	if throw_event and throw_event:IsA("RemoteEvent") then
		throw_event:FireServer(
			Vector3.new(
				-0.5045884847641,
				0.37638658285141,
				-0.77699649333954
			)
		)
	end

	task.wait(0.5)

	return true
end

local blueprints = get_blueprints()

while #blueprints > 0 do
	local batch = 0

	while batch < 2 and #blueprints > 0 do
		local bp = blueprints[1]

		if bp and bp.Parent then
			collect_blueprint(bp)
		end

		batch += 1

		task.wait(0.4)

		blueprints = get_blueprints()
	end

	if #blueprints > 0 or batch > 0 then
		throw_bag()
	end

	task.wait(0.5)

	blueprints = get_blueprints()
end

print("[FARM] Blueprints done")

-- ==================== PACKAGES ====================

print("[FARM] Packages")

local map = workspace:FindFirstChild("Map")
local objects = map and map:FindFirstChild("ObjectsOfInterest")
local loot = objects and objects:FindFirstChild("LootStuff")
local packages_folder = loot and loot:FindFirstChild("Packages")

local function get_packages()
	local results = {}

	if not packages_folder then
		return results
	end

	for _, v in ipairs(packages_folder:GetChildren()) do
		if v:IsA("Model") then
			table.insert(results, v)
		end
	end

	return results
end

local pkgs = get_packages()

while #pkgs > 0 do
	local pkg = pkgs[1]

	if pkg and pkg.Parent then
		print("[FARM] Package: " .. pkg.Name)

		handle_package_gate(pkg)

		local base = pkg:FindFirstChild("Base")

		if base then
			tween_to(base)

			task.wait(0.4)

			local pkg_prompt = wait_for_prompt(base, 3, "ProximityPrompt")

			if pkg_prompt then
				hold_prompt(pkg_prompt, 0.6)
			else
				warn("[PKG] No prompt on Base")
			end
		end
	end

	task.wait(0.3)

	pkgs = get_packages()
end

print("[FARM] Packages done")

-- ==================== COMPUTER ====================

print("[FARM] HackableComputer")

map = workspace:FindFirstChild("Map")
objects = map and map:FindFirstChild("ObjectsOfInterest")

local hack_model = objects and objects:FindFirstChild("HackableComputer")

if hack_model then
	local hack_main = hack_model:FindFirstChild("Main", true)

	if hack_main then
		tween_to(hack_main)

		task.wait(0.5)

		local hack_prompt = wait_for_prompt(hack_main, 5)

		if hack_prompt then
			local hack_timeout = tick() + 60

			while hack_prompt.Parent and tick() < hack_timeout do
				print("[HACK] Holding prompt")

				hold_prompt(hack_prompt, 7.1)

				task.wait(0.5)

				local hacked = objects:FindFirstChild("HackedComputer")

				if hacked then
					break
				end

				if not hack_prompt.Parent then
					break
				end

				if not hack_prompt.Enabled then
					break
				end

				print("[HACK] Not registered, retrying...")
			end
		else
			warn("[HACK] No ProximityPrompt")
		end
	end
end

print("[FARM] Hack done - waiting 30s")

task.wait(30)

-- ==================== USB ====================

print("[FARM] USB")

local function try_grab_usb()
	map = workspace:FindFirstChild("Map")
	objects = map and map:FindFirstChild("ObjectsOfInterest")

	local hacking_computer = objects and objects:FindFirstChild("HackingComputer")
	local usb_drive = hacking_computer and hacking_computer:FindFirstChild("USBDrive")

	if not usb_drive then
		return true
	end

	local usb_main = usb_drive:FindFirstChild("Main", true)

	if not usb_main then
		return false
	end

	tween_to(usb_main)

	task.wait(0.5)

	local usb_prompt = wait_for_prompt(usb_main, 5)

	if not usb_prompt then
		return false
	end

	print("[USB] Using fireproximityprompt")

	dex_fire(usb_prompt)

	task.wait(1)

	return usb_drive.Parent == nil
end

local usb_timeout = tick() + 30
local usb_done = false

while not usb_done and tick() < usb_timeout do
	usb_done = try_grab_usb()

	if not usb_done then
		task.wait(0.5)
	end
end

print("[FARM] USB done")

