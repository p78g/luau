local function collect_blueprint(bp)
	if not bp or not bp.Parent then
		return false
	end

	tween_to(bp)

	-- Give the character time to actually arrive
	task.wait(0.7)

	local prompt = wait_for_prompt(
		bp,
		5,
		"ProximityPrompt"
	)

	if not prompt then
		warn("[BP] Prompt not found")
		return false
	end

	-- Wait for prompt to become usable before firing
	local enable_deadline = tick() + 3

	while prompt.Parent
		and not prompt.Enabled
		and tick() < enable_deadline do

		task.wait(0.1)
	end

	if not prompt.Parent then
		return false
	end

	-- Extra delay prevents firing before the blueprint interaction registers
	task.wait(0.5)

	hold_prompt(
		prompt,
		2.1
	)

	task.wait(0.6)

	return true
end

local function throw_bag()
	if not floor_part or not floor_part.Parent then
		return false
	end

	tween_to(floor_part)

	task.wait(0.7)

	if throw_event and throw_event:IsA("RemoteEvent") then
		throw_event:FireServer(
			Vector3.new(
				-0.5045884847641,
				0.37638658285141,
				-0.77699649333954
			)
		)
	end

	task.wait(0.7)

	return true
end

local blueprints = get_blueprints()

while #blueprints > 0 do
	local batch = 0

	while batch < 2 and #blueprints > 0 do
		local bp = blueprints[1]

		if bp and bp.Parent then
			collect_blueprint(bp)
		end

		batch += 1

		task.wait(0.5)

		blueprints = get_blueprints()
	end

	if batch > 0 then
		throw_bag()
	end

	task.wait(0.5)

	blueprints = get_blueprints()
end

