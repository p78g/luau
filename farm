		head.Anchored = false
	end
end

-- ==================== TWEEN ====================

local function get_target_position(target)
	if typeof(target) == "Vector3" then
		return target
	end

	if typeof(target) ~= "Instance" then
		return nil
	end

	if target:IsA("BasePart") then
		return target.Position
	end

	if target:IsA("Model") then
		local primary = target.PrimaryPart
		if primary then
			return primary.Position
		end

		local part = target:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return part.Position
		end
	end

	return nil
end

local function tween_to(target)
	local pos = get_target_position(target)

	if not pos then
		return false
	end

	if not hrp or not hrp.Parent then
		char = lp.Character or lp.CharacterAdded:Wait()
		hrp = char:WaitForChild("HumanoidRootPart")
	end

	hrp.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 7, 0))
	task.wait(0.1)

	local underground_dest = CFrame.new(pos.X, pos.Y - 7, pos.Z)
	local distance = (hrp.Position - underground_dest.Position).Magnitude
	local duration = math.max(0.1, distance / TWEEN_SPEED)

	local tw = TweenService:Create(
		hrp,
		TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{CFrame = underground_dest}
	)

	tw:Play()
	tw.Completed:Wait()

	task.wait(0.2)

	local tw2 = TweenService:Create(
		hrp,
		TweenInfo.new(0.2, Enum.EasingStyle.Linear),
		{CFrame = underground_dest}
	)

	tw2:Play()
	tw2.Completed:Wait()

	task.wait(0.2)

	local final_dest = CFrame.new(pos)

	local tw3 = TweenService:Create(
		hrp,
		TweenInfo.new(0.3, Enum.EasingStyle.Linear),
		{CFrame = final_dest}
	)

	tw3:Play()
	tw3.Completed:Wait()

	task.wait(0.5)

	return true
end

