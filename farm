-- ==================== CROWBAR ====================

print("[FARM] Crowbar")

local collectables = workspace:FindFirstChild("CollectableHighlights")
local crowbar = collectables and collectables:FindFirstChild("Crowbar")

if crowbar then
	tween_to(crowbar)

	local cb_prompt = wait_for_prompt(crowbar, 5)

