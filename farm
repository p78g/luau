print("[FARM] Crowbar")

local highlights =
	workspace:FindFirstChild("CollectableHighlights")

local crowbar =
	highlights and
	highlights:WaitForChild(
		"Crowbar",
		10
	)

if crowbar then
	local handle =
		crowbar:FindFirstChild("Handle")

	local cb_prompt =
		handle and
		handle:FindFirstChildOfClass(
			"ProximityPrompt"
		)

	tween_to(
		cb_prompt or handle or crowbar
	)

	local timeout = tick() + 15

	print(string.format(
		"[CROWBAR] Arrived at %.2f — firing prompt",
		tick()
	))

	while crowbar.Parent ~= nil
		and tick() < timeout do

		if cb_prompt and cb_prompt.Parent then
			dex_fire(cb_prompt)
		else
			handle =
				crowbar:FindFirstChild("Handle")

			cb_prompt =
				handle and
				handle:FindFirstChildOfClass(
					"ProximityPrompt"
				)
		end

		task.wait(0.2)
	end

	task.wait(0.3)
else
	warn("[FARM] No Crowbar found")
end

print("[FARM] Crowbar done")

-- ==================== CRATES ====================

print("[FARM] RushCrates")

local function get_crates()
	return get_children_named(
		workspace.CollectableHighlights,
		"RushCrate"
	)
end

local crates = get_crates()

while #crates > 0 do
	local crate = pick_random(crates)

	if not crate then
		break
	end

	print(string.format(
		"[CRATE] Tweening to %s at %.2f",
		crate:GetFullName(),
		tick()
	))

	local crate_prompt =
		find_prompt(crate)

	tween_to(
		crate_prompt or crate
	)

	print(string.format(
		"[CRATE] Arrived, firing at %.2f",
		tick()
	))

	local spacer =
		crate:FindFirstChild("Spacer")

	local sp =
		spacer and
		spacer:FindFirstChildOfClass(
			"ProximityPrompt"
		)

	if sp then
		hold_prompt(sp, 2.6)

		print(string.format(
			"[CRATE] Hold complete at %.2f",
			tick()
		))
	end

	task.wait(0.3)

	crates = get_crates()
end

print("[FARM] Crates done")

-- ==================== BLUEPRINTS ====================

print("[FARM] Blueprints")

local throw_event =
	ReplicatedStorage.RS_Package.Remotes.ThrowBag

local floor_part =
	workspace.BagSecuredArea.FloorPart

local function get_blueprints()
	return get_children_named(
		workspace.CollectableHighlights,
		"Blueprint"
	)
end

local function collect_blueprint(bp)
	if not bp or not bp.Parent then
		return false
	end

	local bp_prompt =
		find_prompt(bp)

	tween_to(
		bp_prompt or bp
	)

	task.wait(0.3)

	bp_prompt =
		find_prompt(bp)

	if not bp_prompt then
		task.wait(0.5)

		bp_prompt =
			find_prompt(bp)
	end

	if bp_prompt then
		print(string.format(
			"[BP] Prompt found: %s Enabled=%s",
			bp_prompt:GetFullName(),
			tostring(bp_prompt.Enabled)
		))

		if not bp_prompt.Enabled then
			bp_prompt.Enabled = true
			task.wait(0.15)
		end

		print(string.format(
			"[BP] Starting hold at %.2f",
			tick()
		))

		pcall(function()
			bp_prompt:InputHoldBegin()
		end)

		task.wait(2.1)

		if bp_prompt and bp_prompt.Parent then
			pcall(function()
				bp_prompt:InputHoldEnd()
			end)
		end

		task.wait(0.3)

		return true
	else
		warn(
			"[BP] No ProximityPrompt in: "
				.. bp:GetFullName()
		)

		return false
	end
end

local function throw_bag()
	tween_to(floor_part)

	throw_event:FireServer(
		Vector3.new(
			-0.5045884847641,
			0.37638658285141,
			-0.77699649333954
		)
	)

	task.wait(0.5)
end

local blueprints =
	get_blueprints()

while #blueprints > 0 do
	local batch = 0

	while batch < 2
		and #blueprints > 0 do

		local bp = blueprints[1]

		collect_blueprint(bp)

		batch = batch + 1

		blueprints =
			get_blueprints()

		task.wait(0.2)
	end

	throw_bag()

	blueprints =
		get_blueprints()
end

print("[FARM] Blueprints done")

-- ==================== PACKAGES ====================

print("[FARM] Packages")

local packages_folder =
	workspace.Map.ObjectsOfInterest
	.LootStuff.Packages

local function get_packages()
	local results = {}

	for _, v in ipairs(
		packages_folder:GetChildren()
	) do
		if v:IsA("Model") then
			table.insert(results, v)
		end
	end

	return results
end

local pkgs =
	get_packages()

while #pkgs > 0 do
	local pkg = pkgs[1]

	if not pkg or not pkg.Parent then
		pkgs = get_packages()
		continue
	end

	print("[FARM] Package: " .. pkg.Name)

	handle_package_gate(pkg)

	local base =
		pkg:FindFirstChild("Base")

	local pkg_prompt =
		base and
		base:FindFirstChildOfClass(
			"ProximityPrompt"
		)

	tween_to(
		pkg_prompt or base or pkg
	)

	pkg_prompt =
		base and
		base:FindFirstChildOfClass(
			"ProximityPrompt"
		)

	if pkg_prompt then
		print(string.format(
			"[PKG] Firing at %.2f",
			tick()
		))

		hold_prompt(
			pkg_prompt,
			0.6
		)
	end

	task.wait(0.3)

	pkgs =
		get_packages()
end

print("[FARM] Packages done")

