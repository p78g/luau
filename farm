-- ==================== DEX / FIRE PROXIMITY PROMPT ====================

local function dex_fire(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false
	end

	if typeof(fireproximityprompt) ~= "function" then
		warn("[DEX] fireproximityprompt is unavailable")
		return false
	end

	if not prompt.Parent then
		return false
	end

	pcall(function()
		prompt.Enabled = true
	end)

	local success = pcall(function()
		fireproximityprompt(prompt)
	end)

	return success
end

-- ==================== HOLD PROMPT ====================

local function hold_prompt(prompt, duration)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false
	end

	if not prompt.Parent then
		return false
	end

	pcall(function()
		prompt.Enabled = true
	end)

	task.wait(0.15)

	if not prompt.Parent then
		return false
	end

	local started = pcall(function()
		prompt:InputHoldBegin()
	end)

	if not started then
		return false
	end

	task.wait(duration)

	if prompt.Parent then
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end

	task.wait(0.2)

	return true
end

-- ==================== PROMPT HELPERS ====================

local function find_prompt(parent, preferred_name)
	if not parent then
		return nil
	end

	if preferred_name then
		local preferred = parent:FindFirstChild(preferred_name, true)

		if preferred and preferred:IsA("ProximityPrompt") then
			return preferred
		end
	end

	return parent:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function wait_for_prompt(parent, timeout, preferred_name)
	local start = tick()

	while tick() - start < timeout do
		if not parent or not parent.Parent then
			return nil
		end

		local prompt = find_prompt(parent, preferred_name)

		if prompt and prompt.Parent and prompt:IsA("ProximityPrompt") then
			return prompt
		end

		task.wait(0.1)
	end

	return nil
end

local function get_children_named(parent, name)
	local results = {}

	if not parent then
		return results
	end

	for _, v in ipairs(parent:GetChildren()) do
		if v.Name == name then
			table.insert(results, v)
		end
	end

	return results
end

local function pick_random(t)
	if #t == 0 then
		return nil
	end

	return t[math.random(1, #t)]
end

-- ==================== PACKAGE GATE ====================

local BLOCKED_CF = CFrame.new(
	-118.506042,
	8.12099838,
	-18.7696609,
	-0.999999762,
	0.000258913846,
	-0.000604276371,
	0.000259018154,
	0.99999994,
	-0.000172565764,
	0.000604231667,
	-0.000172722255,
	-0.999999762
)

local function is_package_blocked(pkg_base)
	if not pkg_base or not pkg_base:IsA("BasePart") then
		return false
	end

	return (pkg_base.Position - BLOCKED_CF.Position).Magnitude < 1
end

local function get_closest_removable_frame(ref_pos)
	local best
	local best_dist = math.huge

	local collectables = workspace:FindFirstChild("CollectableHighlights")
	if not collectables then
		return nil
	end

	for _, v in ipairs(collectables:GetChildren()) do
		if v.Name == "RemovableFrame" then
			local main = v:FindFirstChild("Main")

			if main and main:IsA("BasePart") then
				local d = (main.Position - ref_pos).Magnitude

				if d < best_dist then
					best_dist = d
					best = main
				end
			end
		end
	end

	if best and best_dist < 30 then
		return best
	end

	return nil
end

local function get_closest_mini_safe(ref_pos)
	local best
	local best_dist = math.huge

	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end

	for _, child in ipairs(map:GetChildren()) do
		local ms = child:FindFirstChild("MiniSafe")

		if ms then
			local door = ms:FindFirstChild("Door")

			if door and door:IsA("BasePart") then
				local d = (door.Position - ref_pos).Magnitude

				if d < best_dist then
					best_dist = d
					best = ms
				end
			end
		end
	end

	if best and best_dist < 30 then
		return best
	end

	return nil
end

local function handle_package_gate(pkg)
	if not pkg then
		return
	end

	local base = pkg:FindFirstChild("Base")

	if not base or not base:IsA("BasePart") then
		return
	end

	if not is_package_blocked(base) then
		return
	end

	print("[FARM] Package blocked - clearing gate")

	local rf_main = get_closest_removable_frame(base.Position)

	if rf_main then
		tween_to(rf_main)

		local rf_prompt = wait_for_prompt(rf_main, 3)

		if rf_prompt then
			hold_prompt(rf_prompt, 0.3)
			task.wait(0.5)
		end
	end

	local ms = get_closest_mini_safe(base.Position)

	if ms then
		local drill = ms:FindFirstChild("InsertDrill", true)

		if drill then
			local drill_prompt = wait_for_prompt(drill, 3, "ProximityPromptPickLock")

			if drill_prompt then
				tween_to(drill)
				hold_prompt(drill_prompt, 7.6)
				task.wait(0.5)
			end
		end
	end
end

