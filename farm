-- ==================== PROMPT POSITION ====================

local function get_prompt_world_position(prompt)
	if not prompt or not prompt.Parent then
		return nil
	end

	-- ProximityPrompt does NOT have an Adornee property.
	-- Resolve the position from its parent instead.

	local parent = prompt.Parent

	if parent:IsA("Attachment") then
		return parent.WorldPosition
	end

	if parent:IsA("BasePart") then
		return parent.Position
	end

	if parent:IsA("Model") then
		local primary = parent.PrimaryPart

		if primary then
			return primary.Position
		end

		return parent:GetPivot().Position
	end

	local attachment =
		parent:FindFirstChildWhichIsA("Attachment", true)

	if attachment then
		return attachment.WorldPosition
	end

	local part =
		parent:FindFirstChildWhichIsA("BasePart", true)

	if part then
		return part.Position
	end

	local ancestor_part =
		prompt:FindFirstAncestorWhichIsA("BasePart")

	if ancestor_part then
		return ancestor_part.Position
	end

	local ancestor_model =
		prompt:FindFirstAncestorWhichIsA("Model")

	if ancestor_model then
		return ancestor_model:GetPivot().Position
	end

	return nil
end

local function find_target_prompt(target)
	if not target then
		return nil
	end

	if target:IsA("ProximityPrompt") then
		return target
	end

	for _, v in ipairs(target:GetDescendants()) do
		if v:IsA("ProximityPrompt") then
			return v
		end
	end

	return nil
end

local function resolve_target_position(target)
	if typeof(target) == "Vector3" then
		return target
	end

	if not target or not target.Parent then
		return nil
	end

	if target:IsA("ProximityPrompt") then
		return get_prompt_world_position(target)
	end

	local prompt = find_target_prompt(target)

	if prompt then
		local prompt_pos =
			get_prompt_world_position(prompt)

		if prompt_pos then
			return prompt_pos
		end
	end

	if target:IsA("BasePart") then
		return target.Position
	end

	if target:IsA("Attachment") then
		return target.WorldPosition
	end

	if target:IsA("Model") then
		local primary = target.PrimaryPart

		if primary then
			return primary.Position
		end

		return target:GetPivot().Position
	end

	return nil
end

-- ==================== TWEEN ====================

local function tween_to(target)
	if not hrp or not hrp.Parent then
		return false
	end

	local pos = resolve_target_position(target)

	if not pos then
		warn("[TWEEN] Could not resolve target position")
		return false
	end

	local start_pos = hrp.Position

	-- Start below target, never above it.
	if start_pos.Y > pos.Y - 7 then
		hrp.CFrame =
			CFrame.new(
				start_pos.X,
				pos.Y - 7,
				start_pos.Z
			)
	end

	task.wait(0.1)

	local underground_dest =
		CFrame.new(
			pos.X,
			pos.Y - 7,
			pos.Z
		)

	local distance =
		(hrp.Position - underground_dest.Position).Magnitude

	local duration =
		math.max(0.1, distance / TWEEN_SPEED)

	print(string.format(
		"[TWEEN] start %.2f dist %.1f dur %.2fs",
		tick(),
		distance,
		duration
	))

	local tw = TweenService:Create(
		hrp,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = underground_dest
		}
	)

	tw:Play()
	tw.Completed:Wait()

	task.wait(0.2)

	local live_pos =
		resolve_target_position(target) or pos

	-- Move to interaction range while remaining below prompt.
	local near_dest =
		CFrame.new(
			live_pos.X,
			live_pos.Y - 1.5,
			live_pos.Z
		)

	local distance2 =
		(hrp.Position - near_dest.Position).Magnitude

	local duration2 =
		math.max(0.1, distance2 / TWEEN_SPEED)

	local tw2 = TweenService:Create(
		hrp,
		TweenInfo.new(
			duration2,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = near_dest
		}
	)

	tw2:Play()
	tw2.Completed:Wait()

	task.wait(0.1)

	live_pos =
		resolve_target_position(target) or live_pos

	-- Final position stays below the prompt.
	local final_dest =
		CFrame.new(
			live_pos.X,
			live_pos.Y - 1,
			live_pos.Z
		)

	local tw3 = TweenService:Create(
		hrp,
		TweenInfo.new(
			0.15,
			Enum.EasingStyle.Linear
		),
		{
			CFrame = final_dest
		}
	)

	tw3:Play()
	tw3.Completed:Wait()

	task.wait(0.25)

	print(string.format(
		"[TWEEN] prompt-safe position %.2f",
		tick()
	))

	return true
end

