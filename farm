-- ==================== DEX FIRE ====================

local function dex_fire(prompt)
	if not prompt or not prompt.Parent then
		return false
	end

	local ok = pcall(function()
		fireproximityprompt(prompt)
	end)

	return ok
end

-- ==================== HOLD PROMPT ====================

local function hold_prompt(prompt, duration)
	if not prompt or not prompt.Parent then
		return false
	end

	task.wait(0.15)

	local ok = pcall(function()
		prompt:InputHoldBegin()
	end)

	if not ok then
		return false
	end

	task.wait(duration)

	if prompt and prompt.Parent then
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end

	task.wait(0.1)

	return true
end

-- ==================== HELPERS ====================

local function get_children_named(parent, name)
	local results = {}

	if not parent then
		return results
	end

	for _, v in ipairs(parent:GetChildren()) do
		if v.Name == name then
			table.insert(results, v)
		end
	end

	return results
end

local function pick_random(t)
	if #t == 0 then
		return nil
	end

	return t[math.random(1, #t)]
end

local function find_prompt(parent)
	if not parent then
		return nil
	end

	if parent:IsA("ProximityPrompt") then
		return parent
	end

	for _, v in ipairs(parent:GetDescendants()) do
		if v:IsA("ProximityPrompt") then
			return v
		end
	end

	return nil
end

-- ==================== PACKAGE GATE ====================

local BLOCKED_CF = CFrame.new(
	-118.506042,
	8.12099838,
	-18.7696609,
	-0.999999762,
	0.000258913846,
	-0.000604276371,
	0.000259018154,
	0.99999994,
	-0.000172565764,
	0.000604231667,
	-0.000172722255,
	-0.999999762
)

local function is_package_blocked(pkg_base)
	if not pkg_base then
		return false
	end

	return (
		pkg_base.CFrame.Position
		- BLOCKED_CF.Position
	).Magnitude < 1.0
end

local function get_closest_removable_frame(ref_pos)
	local best, best_dist = nil, math.huge

	local highlights =
		workspace:FindFirstChild("CollectableHighlights")

	if not highlights then
		return nil
	end

	for _, v in ipairs(highlights:GetChildren()) do
		if v.Name == "RemovableFrame" then
			local main = v:FindFirstChild("Main")

			if main and main:IsA("BasePart") then
				local d =
					(main.Position - ref_pos).Magnitude

				if d < best_dist then
					best_dist = d
					best = main
				end
			end
		end
	end

	if best and best_dist < 30 then
		return best
	end

	return nil
end

local function get_closest_mini_safe(ref_pos)
	local best, best_dist = nil, math.huge

	local map = workspace:FindFirstChild("Map")

	if not map then
		return nil
	end

	for _, child in ipairs(map:GetChildren()) do
		local ms = child:FindFirstChild("MiniSafe")

		if ms then
			local door = ms:FindFirstChild("Door")

			if door and door:IsA("BasePart") then
				local d =
					(door.Position - ref_pos).Magnitude

				if d < best_dist then
					best_dist = d
					best = ms
				end
			end
		end
	end

	if best and best_dist < 30 then
		return best
	end

	return nil
end

local function handle_package_gate(pkg)
	local base = pkg:FindFirstChild("Base")

	if not base or not is_package_blocked(base) then
		return
	end

	print("[FARM] Package blocked — clearing frame then safe")

	local rf_main =
		get_closest_removable_frame(base.Position)

	if rf_main then
		local rf_prompt =
			rf_main:FindFirstChildOfClass(
				"ProximityPrompt"
			)

		tween_to(
			rf_prompt or rf_main
		)

		if rf_prompt then
			print(string.format(
				"[GATE] Firing RemovableFrame at %.2f",
				tick()
			))

			hold_prompt(rf_prompt, 0.3)
			task.wait(0.5)
		end
	end

	local ms =
		get_closest_mini_safe(base.Position)

	if ms then
		local drill =
			ms:FindFirstChild("InsertDrill")

		if drill then
			local drill_prompt =
				drill:FindFirstChild(
					"ProximityPromptPickLock"
				)

			if drill_prompt then
				tween_to(drill_prompt)

				print(string.format(
					"[GATE] Firing MiniSafe at %.2f",
					tick()
				))

				hold_prompt(drill_prompt, 7.6)
				task.wait(0.5)
			end
		end
	end
end

